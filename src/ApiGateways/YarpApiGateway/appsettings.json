{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "Authentication": {
    "Authority": "https://9261b797-fda8-44bb-a460-04e0504ebd82.ciamlogin.com/9261b797-fda8-44bb-a460-04e0504ebd82/v2.0",
    "Audiences": [
      "aad4dd1c-0a4a-4b3b-b51b-f751248ae885",
      "8669dcf0-e084-464a-b4ff-2068c851b08b",
      "99422d49-14e2-4deb-9fb4-45c42592377e"
    ]
  },
  "ElasticConfiguration":{
    "Uri": "http://localhost:9200"
  },
  "HealthCheckServices": {
    "catalog-api": "http://catalog.api:80",
    "basket-api": "http://basket.api:80",
    "ordering-api": "http://ordering.api:80"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/catalog-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/basket-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/ordering-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog.api:80"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://basket.api:80"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://ordering.api:80"
          }
        }
      }
    }
  }
}